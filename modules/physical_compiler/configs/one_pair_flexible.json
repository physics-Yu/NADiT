{
  "name": "one_pair_flexible",
  "zones": [
    {
      "id": "storage",
      "bounds": {"x_min": 0, "y_min": 0, "x_max": 20, "y_max": 10},
      "operations": ["load", "store", "rotate", "reset"]
    },
    {
      "id": "entanglement",
      "bounds": {"x_min": 0, "y_min": 120, "x_max": 20, "y_max": 120},
      "operations": ["load", "store", "cz", "rotate", "reset"]
    },
    {
      "id": "measurement",
      "bounds": {"x_min": 0, "y_min": 240, "x_max": 20, "y_max": 250},
      "operations": ["measure"]
    }
  ],
  "slm_grids": [
    {
      "prefix": "storage",
      "origin": {"x": 0, "y": 0},
      "rows": 2,
      "columns": 3,
      "pitch": {"x": 5, "y": 5}
    }
  ],
  "slm_sites": [
    {"id": "gate_0_left", "position": {"x": 0, "y": 120}},
    {"id": "gate_0_right", "position": {"x": 2, "y": 120}},
    {"id": "gate_1_left", "position": {"x": 8, "y": 120}},
    {"id": "gate_1_right", "position": {"x": 10, "y": 120}}
  ],
  "aods": [
    {
      "id": "transport",
      "workspace": {"x_min": -10, "y_min": -10, "x_max": 30, "y_max": 260},
      "min_spacing": 1,
      "max_rows": null,
      "max_columns": null
    }
  ],
  "timing": {"load_us": 10, "store_us": 10, "move_us_per_um": 1},
  "cz": {
    "channel": "rydberg",
    "radius_um": 4.6,
    "duration_us": 0.5,
    "holder_pairs": [["slm", "slm"], ["slm", "aod"], ["aod", "aod"]]
  },
  "local": {"channel": "raman", "rotation_us": 1, "reset_us": 5},
  "readout": {
    "channel": "camera",
    "duration_us": 10,
    "latency_us": 150,
    "min_spacing_um": 5,
    "retain_atoms": true,
    "holders": ["slm", "aod"]
  }
}
