OPENQASM 3.0;
include "stdgates.inc";
// encoded-lookahead-9; A=1 only; all 512 exponents; exact binary 2^x mod21; E restored by oracle; no extra garbage
// q[0] is A LSB; b[0] is measured first and is c_out LSB.
qubit[14] q;
bit[9] b;
reset q[0];
reset q[1];
reset q[2];
reset q[3];
reset q[4];
x q[2];
reset q[13];
h q[13];
reset q[12];
h q[12];
cx q[12], q[0];
cx q[13], q[0];
h q[13];
b[0] = measure q[13];
reset q[11];
h q[11];
cx q[12], q[11];
ccx q[11], q[0], q[2];
cx q[12], q[11];
if (b[0]) { p(-1*pi/2) q[12]; }
h q[12];
b[1] = measure q[12];
reset q[10];
h q[10];
cx q[11], q[10];
ccx q[10], q[2], q[0];
cx q[11], q[10];
if (b[0]) { p(-1*pi/4) q[11]; }
if (b[1]) { p(-1*pi/2) q[11]; }
h q[11];
b[2] = measure q[11];
reset q[9];
h q[9];
cx q[10], q[9];
ccx q[9], q[0], q[2];
cx q[10], q[9];
if (b[0]) { p(-1*pi/8) q[10]; }
if (b[1]) { p(-1*pi/4) q[10]; }
if (b[2]) { p(-1*pi/2) q[10]; }
h q[10];
b[3] = measure q[10];
reset q[8];
h q[8];
cx q[9], q[8];
ccx q[8], q[2], q[0];
cx q[9], q[8];
if (b[0]) { p(-1*pi/16) q[9]; }
if (b[1]) { p(-1*pi/8) q[9]; }
if (b[2]) { p(-1*pi/4) q[9]; }
if (b[3]) { p(-1*pi/2) q[9]; }
h q[9];
b[4] = measure q[9];
reset q[7];
h q[7];
cx q[8], q[7];
ccx q[7], q[0], q[2];
cx q[8], q[7];
if (b[0]) { p(-1*pi/32) q[8]; }
if (b[1]) { p(-1*pi/16) q[8]; }
if (b[2]) { p(-1*pi/8) q[8]; }
if (b[3]) { p(-1*pi/4) q[8]; }
if (b[4]) { p(-1*pi/2) q[8]; }
h q[8];
b[5] = measure q[8];
reset q[6];
h q[6];
cx q[7], q[6];
ccx q[6], q[2], q[0];
cx q[7], q[6];
if (b[0]) { p(-1*pi/64) q[7]; }
if (b[1]) { p(-1*pi/32) q[7]; }
if (b[2]) { p(-1*pi/16) q[7]; }
if (b[3]) { p(-1*pi/8) q[7]; }
if (b[4]) { p(-1*pi/4) q[7]; }
if (b[5]) { p(-1*pi/2) q[7]; }
h q[7];
b[6] = measure q[7];
ccx q[6], q[0], q[2];
if (b[0]) { p(-1*pi/128) q[6]; }
if (b[1]) { p(-1*pi/64) q[6]; }
if (b[2]) { p(-1*pi/32) q[6]; }
if (b[3]) { p(-1*pi/16) q[6]; }
if (b[4]) { p(-1*pi/8) q[6]; }
if (b[5]) { p(-1*pi/4) q[6]; }
if (b[6]) { p(-1*pi/2) q[6]; }
h q[6];
b[7] = measure q[6];
reset q[5];
h q[5];
cx q[5], q[3];
if (b[0]) { p(-1*pi/256) q[5]; }
if (b[1]) { p(-1*pi/128) q[5]; }
if (b[2]) { p(-1*pi/64) q[5]; }
if (b[3]) { p(-1*pi/32) q[5]; }
if (b[4]) { p(-1*pi/16) q[5]; }
if (b[5]) { p(-1*pi/8) q[5]; }
if (b[6]) { p(-1*pi/4) q[5]; }
if (b[7]) { p(-1*pi/2) q[5]; }
h q[5];
b[8] = measure q[5];
cx q[0], q[2];
cx q[2], q[0];
x q[2];
x q[0];
